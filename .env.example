# Frontend (nginx) host port
HEXY_WEB_PORT=8080

# Backend (FastAPI) host port — used for direct dev access; the frontend proxies
# /mujoco, /assets/rl, /assets/cave to the backend over the compose network,
# so most users hit only HEXY_WEB_PORT.
HEXY_API_PORT=8000

# Training accelerator (only relevant when running the `learning` / `learning-gpu`
# services under their compose profiles). Use `cpu` on any machine; use `cuda12`
# only on hosts with NVIDIA Container Toolkit.
JAX_ACCELERATOR=cpu

# Optional: CUDA arch list for building llama-cpp-python in the backend image.
# Leave unset for a broad multi-GPU build (`all-major`), or set a specific value
# like `75` (GTX 1650) or `86` (RTX 3070 Laptop) for a tighter per-machine build.
# LLAMA_CPP_CUDA_ARCH=all-major

# buat download grounding dino, dapetin tokennya di https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token
